    subscription VideoHighlightsStream($videoId: ID!, $runId: ID!, $password: String) {
  videoHighlightsStream(videoId: $videoId, runId: $runId, password: $password) {
    streamId
    envelopeVersion
    sequence
    eventType
    timestamp
    statusPayload {
      status
      phase
      message
    }
    narrationPartPayload {
      narration
      partId
      isFinalPart
    }
    contentPartPayload {
      contentType
      partId
      content
    }
    finalResponsePayload {
      highlights {
        id
        promptVersion
        llmBackend
        takeaways {
          header
          bullets {
            text
          }
          imagePreview
          timestamp {
            start
            end
          }
        }
        actions {
          type
          header
          body
        }
      }
    }
    errorPayload {
      code
      message
    }
  }
}
