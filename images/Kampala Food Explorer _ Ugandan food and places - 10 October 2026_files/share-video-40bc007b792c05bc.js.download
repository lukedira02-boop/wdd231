    query GetVideoHighlights($videoId: ID!, $password: String) {
  getVideoHighlights(videoId: $videoId, password: $password) {
    ... on VideoHighlightsPayload {
      isPersonalized
      canIncludeUgcFeedbackContext
      loomCategory
      highlights {
        id
        promptVersion
        llmBackend
        takeaways {
          header
          bullets {
            text
          }
          imagePreview
          timestamp {
            start
            end
          }
        }
        actions {
          type
          header
          body
        }
      }
    }
    ... on VideoHighlightsPending {
      runId
      status
      isPersonalized
    }
    ... on VideoHighlightsNotStarted {
      status
    }
    ... on VideoHighlightsIneligible {
      code
      message
    }
    ... on GenericError {
      message
    }
    ... on UserNotAuthorizedError {
      message
    }
  }
}
