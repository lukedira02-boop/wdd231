    query GetVideoSupportsCamPickerAndZooms($videoId: ID!, $password: String) {
  getVideo(id: $videoId, password: $password) {
    ... on RegularUserVideo {
      id
      supportsCameraBubbleRegion
      supportsEditZoomInstructions
      editZoomInstructions {
        id
      }
    }
