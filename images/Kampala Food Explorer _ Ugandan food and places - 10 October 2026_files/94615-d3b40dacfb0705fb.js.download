    mutation UpdateVideoCta($videoId: ID!, $cta: CtaInput!, $password: String) {
  updateVideoCta(videoId: $videoId, cta: $cta, password: $password) {
    __typename
    ... on UpdateVideoCtaPayload {
      video {
        id
        cta {
          url
          text
          enabled
          is_auto
          approved_at
          mods
        }
      }
    }
    ... on InvalidRequestWarning {
      message
    }
    ... on Error {
      message
    }
  }
}
