    query FetchVideosById($videoIds: [ID!]!) {
  fetchVideosById(videoIds: $videoIds) {
    ... on FetchVideosByIdPayload {
      __typename
      videos {
        ...VideoFields
        ...VideoPlayerV2Fragment
      }
    }
    ... on Error {
      message
    }
  }
}
