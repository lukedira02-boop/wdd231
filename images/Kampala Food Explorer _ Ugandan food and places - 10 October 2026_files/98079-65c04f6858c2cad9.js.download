    mutation ConsolidatedAddEditZoomInstructionToVideo($input: AddEditZoomInstructionToVideoInput!) {
  addEditZoomInstructionToVideo(input: $input) {
    __typename
    ... on AddEditZoomInstructionToVideoPayload {
      video {
        ...ConsolidatedEditZoomInstructions
        ...ConsolidatedEditVideoPreview
      }
      zoomId
    }
    ... on UserNotAuthorizedError {
      message
    }
    ... on GenericError {
      message
    }
    ... on InvalidRequestWarning {
      message
    }
  }
}
