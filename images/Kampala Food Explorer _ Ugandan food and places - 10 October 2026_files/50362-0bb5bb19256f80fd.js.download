    query GetAvailablePlaylistsForPopover($limit: Int, $sortField: AvailablePlaylistsSortField, $sortDirection: AvailablePlaylistsSortDirection) {
  getAvailablePlaylists(
    limit: $limit
    sortField: $sortField
    sortDirection: $sortDirection
  ) {
    ... on GetAvailablePlaylistsPayload {
      playlists {
        nodes {
          playlistId
          name
          thumbnailUrl
          videoCount
          privacy
        }
      }
    }
    ... on UserNotAuthorizedError {
      message
    }
    ... on GenericError {
      message
    }
  }
}
