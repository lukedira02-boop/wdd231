    query GetWorkspaceSetting($settingName: String!, $includeTimestamps: Boolean = false, $workspaceIdv2: ID) {
  getWorkspaceSetting(
    settingName: $settingName
    includeTimestamps: $includeTimestamps
    workspaceIdv2: $workspaceIdv2
  ) {
    ... on Setting {
      id
      setting {
        __typename
        ... on BooleanObject {
          id
          booleanValue: value
        }
        ... on IntObject {
          id
          intValue: value
        }
        ... on StringObject {
          id
          stringValue: value
        }
        ... on JSONObject {
          id
          jsonValue: value
        }
      }
      createdAt @include(if: $includeTimestamps)
      updatedAt @include(if: $includeTimestamps)
    }
  }
}
