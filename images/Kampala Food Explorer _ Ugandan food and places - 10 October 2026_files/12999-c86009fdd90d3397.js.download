    mutation UpdateWorkspaceSetting($name: String!, $value: BasicScalar!) {
  result: updateWorkspaceSetting(name: $name, value: $value) {
    ... on UpdatedWorkspaceSetting {
      setting {
        name
        value
      }
      created
      updated
    }
  }
}
