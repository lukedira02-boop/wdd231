    mutation DeleteWorkspaceSetting($name: String!) {
  result: deleteWorkspaceSetting(name: $name) {
    ... on DeletedWorkspaceSetting {
      success
    }
    ... on UserNotAuthorizedError {
      message
    }
    ... on GenericError {
      message
    }
  }
}
