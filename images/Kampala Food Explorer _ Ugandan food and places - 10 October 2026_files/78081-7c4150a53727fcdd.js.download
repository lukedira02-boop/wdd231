    mutation CreateFileUploadCredentials($sessionId: ID) {
  createFileUploadCredentials(sessionId: $sessionId) {
    ... on CreateFileUploadCredentialsPayload {
      __typename
      sessionId
      credentials {
        ... on ObjectStoreInfo {
          hostname
          bucket
          workspaceType
          siteId
          activationId
          token {
            value
            expiration
          }
        }
        ... on S3Info {
          accessKeyId
          secretAccessKey
          sessionToken
          bucket
          region
        }
      }
    }
    ... on UserNotAuthorizedError {
      message
    }
    ... on GenericError {
      message
    }
  }
