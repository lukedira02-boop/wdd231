    query GetInProgressPlaylists($first: Int, $after: String) {
  getInProgressPlaylists {
    ... on GetInProgressPlaylistsPayload {
      playlists(first: $first, after: $after) {
        pageInfo {
          hasNextPage
          endCursor
        }
        nodes {
          playlistId
          name
          thumbnailUrl
          videoCount
          watchedVideoCount
          progressPercent
          nextVideoId
          totalDuration
          owner {
            id
            display_name
            avatars {
              thumb
            }
          }
          videos {
            videoId
            name
            playableDuration
            thumbnailUrl
            viewerCanAccess
            isPasswordProtected
            owner {
              display_name
              avatars {
                thumb
              }
            }
          }
        }
      }
    }
  }
}
