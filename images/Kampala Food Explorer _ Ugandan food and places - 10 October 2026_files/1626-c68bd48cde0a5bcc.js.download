1)`
    query GetPlaylistViewerInsights($playlistId: ID!, $first: Int, $afterViewerIdExclusive: Int) {
  getPlaylistViewerInsights(
    playlistId: $playlistId
    first: $first
    afterViewerIdExclusive: $afterViewerIdExclusive
  ) {
    __typename
    ... on PlaylistViewerInsights {
      playlistId
      avgCompletionRate
      viewerEngagement {
        userId
        fullName
        profileUrl
        commentCount
        reactionCount
      }
      pageInfo {
        hasNextPage
        endCursorViewerIdExclusive
      }
    }
    ... on UserNotAuthorizedError {
      message
    }
    ... on GenericError {
      message
    }
  }
}
