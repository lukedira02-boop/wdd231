  result: getMySpaceMemberships {
    __typename
    ... on GetMySpaceMembershipsPayload {
      memberships(first: $first, after: $after) {
        edges {
          node {
            id
            unread
            space {
              id
              name
              privacy
              is_primary
            }
          }
        }

        pageInfo {
          endCursor
          hasNextPage
        }
      }
    }
    ... on Error {
      message
    }
  }
}
