    query UtilityMemberTypeaheadQuery($workspaceId: ID!, $query: String!, $limit: Int, $includeContacts: Boolean!, $selectedUserId: ID) {
  searchWorkspaceMembers(
    workspaceId: $workspaceId
    query: $query
    limit: $limit
    selectedUserId: $selectedUserId
  ) {
    ... on SearchWorkspaceMembersResult {
      users {
        id
        display_name
        email
        avatars {
          thumb
          isAtlassianMastered
        }
      }
    }
  }
  searchWorkspaceContacts(query: $query, limit: $limit) @include(if: $includeContacts) {
    ... on SearchWorkspaceContactsPayload {
      results {
        id
        avatarUrl
        displayName
        value
        source
        type
      }
    }
  }
}
