    query GetSpaceNameAndMembers($spaceId: ID!, $first: Int!, $after: String) {
  getSpaceMembers(spaceId: $spaceId) {
    __typename
    ... on GetSpaceMembersPayload {
      members(spaceId: $spaceId, first: $first, after: $after) {
        edges {
          node {
            id
            user {
              id
              first_name
              last_name
              avatars {
                thumb
              }
            }
          }
        }
      }
    }
    ... on Error {
      message
    }
  }
  getSpace(spaceId: $spaceId) {
    __typename
    ... on GetSpacePayload {
      __typename
      space {
        id
        is_primary
        name
        privacy
        totalFolders
        totalVideos
        topUsedTags {
          tag
        }
        membersCount
        currentUserIsMember
        isArchived
        createdAt
      }
    }
    ... on Error {
      message
    }
  }
}
