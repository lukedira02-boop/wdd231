    `,Y=(0,H.J1)`
    query GetSuggestedSpaces($recommendedSpaceLimit: Int!, $after: String) {
  recommendedSpaces: getSharingRecommendations {
    ... on GetSharingRecommendationsPayload {
      recommendations(first: $recommendedSpaceLimit, after: $after) {
        nodes {
          ... on SpaceRecommendationType {
            space {
              ...SuggestedSpace
            }
          }
        }
      }
      totalRecommendations
    }
    ... on Error {
      message
    }
  }
  primarySpace: getPrimarySpace {
    ... on GetPrimarySpacePayload {
      space {
        ...SuggestedSpace
      }
    }
