    query GetLoomsForFeedQuery($followingFilters: [[LoomsCollectionFilter!]!], $publishedFilters: [[LoomsCollectionFilter!]!], $skipFollowingQuery: Boolean!, $numberFromFollowing: Int!, $numberFromNewlyPublished: Int!, $followingSource: LoomsSource!, $followingSourceValues: [String!], $newlyPublishedSource: LoomsSource!, $newlyPublishedValues: [String!]) {
  following: getLooms @skip(if: $skipFollowingQuery) {
    __typename
    ... on GetLoomsPayload {
      videos(
        first: $numberFromFollowing
        source: $followingSource
        sourceValues: $followingSourceValues
        sortType: RECENT
        sortOrder: DESC
        filters: $followingFilters
      ) {
        edges {
          node {
            id
          }
        }
      }
    }
  }
  newlyPublished: getLooms {
    __typename
    ... on GetLoomsPayload {
      videos(
        first: $numberFromNewlyPublished
        source: $newlyPublishedSource
        sourceValues: $newlyPublishedValues
        sortType: RECENT
        sortOrder: DESC
        filters: $publishedFilters
      ) {
        edges {
          node {
            id
          }
        }
      }
    }
  }
}
