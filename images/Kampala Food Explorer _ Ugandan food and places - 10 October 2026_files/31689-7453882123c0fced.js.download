    query GetPaywallRequestData($workspaceId: ID!) {
  billing: getWorkspaceBillingDetails(workspaceId: $workspaceId) {
    billing_details {
      customer {
        currency
      }
      plan {
        id
        pure_trial
      }
      add_ons {
        id
        price {
          id
          nickname
          product
          unit_amount
          recurring {
            interval
            interval_count
          }
        }
      }
      paused {
        id
        status
        phases {
          start_date
          end_date
          items {
            quantity
            price
          }
        }
      }
    }
  }
  request_status: getUpgradeWorkspaceRequestStatus {
    ... on GetUpgradeWorkspaceRequestStatusPayload {
      status
    }
