    query GetPlaylistAccess($playlistId: ID!) {
  getPlaylistAccess(playlistId: $playlistId) {
    __typename
    ... on PlaylistAccessData {
      ownerId
      generalAccessLevel
      generalPermissionLevel
      users {
        playlistId
        userId
        access
        user {
          id
          fullName
          email
          avatarUrl
        }
      }
      spaces {
        playlistId
        spaceId
        access
        space {
          id
          name
        }
      }
    }
    ... on GenericError {
      message
    }
    ... on UserNotAuthorizedError {
      message
    }
  }
}
